# On the server: copy to deploy/pi/.env (chmod 600) and fill in.

# claude_cli uses the Claude Code CLI with your Claude subscription (no API key needed).
# Alternatives: anthropic (needs ANTHROPIC_API_KEY), openai (needs OPENAI_API_KEY), fake (test stories).
STORY_PROVIDER=claude_cli
# From: docker compose run --rm --no-deps story claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# Same value as DEVICE_TOKEN in backend/.env on your computer (install.sh copies it to the Kindle).
# Generate with: openssl rand -hex 16
DEVICE_TOKEN=

# LAN IP of this server – the container listens only there (not on 0.0.0.0)
LAN_IP=192.168.1.50

STORIES_PER_HOUR=12
LLM_TIMEOUT_S=150
LLM_MAX_RETRIES=1
