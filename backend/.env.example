# Copy to backend/.env and fill in. Never commit .env.
# Used by backend/run.sh (local dev) and by kindle/install.sh.

# claude_cli (Claude Code CLI, subscription login) | anthropic (API key) | openai | fake (test stories)
STORY_PROVIDER=fake
# for claude_cli: token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# for anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low = faster, high = more careful
ANTHROPIC_EFFORT=medium
# for openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Shared secret between Kindle and backend. Generate with: openssl rand -hex 16
DEVICE_TOKEN=

# For kindle/install.sh: backend addresses the Kindle tries in order (space separated)
KINDLE_BACKEND_URLS="http://192.168.1.50:8787"

STORIES_PER_HOUR=12
LLM_TIMEOUT_S=150
